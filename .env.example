# Telegram
TELEGRAM_BOT_TOKEN=
# Admins: can use the bot everywhere it is allowed and manage users with /allow /disallow /allowed
ADMIN_USER_IDS=
# Comma-separated Telegram user ids allowed to use the bot in DMs (fixed; users added with /allow go to ACCESS_FILE)
ALLOWED_USER_IDS=
# Where users added with /allow are stored (keep it on a volume when running in Docker)
ACCESS_FILE=data/access.json
# Comma-separated group/supergroup chat ids where any member can use the bot (e.g. -1001234567890)
# Unlisted chats are denied; sending a command there makes the bot reply with the id to add.
ALLOWED_CHAT_IDS=
# Optional HTTP proxy for api.telegram.org only (e.g. http://127.0.0.1:7897)
TELEGRAM_PROXY=

# Dokploy (Settings > Profile > API/CLI to create a key)
DOKPLOY_URL=http://182.215.187.53:3000
DOKPLOY_API_KEY=
# Project the bot creates/uses for every service
DOKPLOY_PROJECT=deploy-bot
# Optional remote server id; empty = Dokploy host
DOKPLOY_SERVER_ID=

# Domains: <repo>.<BASE_DOMAIN>. Needs a wildcard DNS record *.BASE_DOMAIN -> Dokploy server IP
BASE_DOMAIN=arpa.page
DOMAIN_HTTPS=true
RAILPACK_VERSION=0.15.4

# Optional: GitHub token for private repos / higher API rate limit (read-only contents scope)
GITHUB_TOKEN=

# Optional: AI Dockerfile generation when Railpack fails.
# Every provider with a key joins the chain; on error/rate limit/timeout/bad reply the next one is tried.
# Default order: ollama > mistral > openrouter > custom (AI_*). Override with AI_PROVIDER_ORDER=mistral,ollama
# Ollama Cloud (pay per token, https://ollama.com/settings/keys). Cheap picks: gpt-oss:120b, glm-5.3-flash, mimo-v2.6-flash
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Any other OpenAI-compatible API
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_ORDER=
AI_MAX_ATTEMPTS=2
AI_TIMEOUT_SEC=60

DEPLOY_TIMEOUT_MIN=30
POLL_INTERVAL_MS=5000
